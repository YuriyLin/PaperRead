{
  "name": "paperread-desktop",
  "version": "1.5.1",
  "description": "PaperRead personal research workspace",
  "author": {
    "name": "YuriyLin"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:editor": "node scripts/build_note_editor.cjs",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run build:editor && npm run build:backend && electron-builder --publish never"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.106.1"
  },
  "build": {
    "appId": "com.edwardxlai.easyread",
    "productName": "PaperRead",
    "protocols": [
      {
        "name": "PaperRead",
        "schemes": [
          "easyread",
          "paperread"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets/paperread.ico",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/paperread.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "electron/assets/paperread.ico",
      "uninstallerIcon": "electron/assets/paperread.ico",
      "artifactName": "PaperRead-Setup-${version}.exe",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YuriyLin",
        "repo": "PaperRead"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YuriyLin/PaperRead.git"
  }
}
